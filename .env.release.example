# Copy this file to .env.release and adjust only non-secret release settings.
# Secrets belong in root-readable files referenced by the two *_FILE paths.
COOKING_BLOG_VERSION=0.1.0
COOKING_BLOG_HTTP_PORT=8080
COOKING_BLOG_POSTGRES_PASSWORD_FILE=./secrets/postgres_password
COOKING_BLOG_AUTH_PASSWORD_FILE=./secrets/auth_password
